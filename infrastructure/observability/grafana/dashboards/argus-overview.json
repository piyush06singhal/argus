    {
      "id": 22,
      "type": "timeseries",
      "title": "Backups \u2014 runs, size and duration",
      "description": "A climbing FAILED line with a flat size is the pattern that says the schedule is firing and cannot succeed.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "argus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (argus_backup_runs_24h_by_status)",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "argus-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "argus_backup_last_size_bytes / 1048576",
          "legendFormat": "size (MiB)",
          "datasource": {
            "type": "prometheus",
            "uid": "argus-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "argus_backup_last_duration_seconds",
          "legendFormat": "duration (s)",
          "datasource": {
            "type": "prometheus",
            "uid": "argus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Restore rehearsal age",
      "description": "Days since the last successful drill. Verification proves the archive is readable; only a restore proves it reproduces the data.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": {
        "type": "prometheus",
        "uid": "argus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - argus_backup_last_drill_timestamp_seconds) / 86400",
          "datasource": {
            "type": "prometheus",
            "uid": "argus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "mode": "absolute",
            "steps": [
