          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Access \u2014 single sign-on (24h)",
      "description": "Successful and refused SSO logins. Both series are initialized at zero on startup, so an empty panel means 'no logins', not 'no data' \u2014 the distinction a rate() would hide. A rise in refusals is worth reading the authentication audit for: the reason codes separate policy working as configured (email_domain, identity_disabled) from a provider misconfiguration or probing (id_token_invalid, state_unknown).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "argus-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(argus_oidc_logins_total[$__range])",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "expr": "increase(argus_oidc_login_failures_total[$__range])",
          "legendFormat": "refused"
        }
      ]
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Single sign-on enabled",
      "description": "1 when an identity provider is configured on this deployment. Read with the panel beside it: 'configured' and 'working' are different claims, and only a successful login tests the second.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "datasource": {
        "type": "prometheus",
        "uid": "argus-prometheus"
      },
      "fieldConfig": {
