# ARGUS Environment Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://argus:argus_password@postgres:5432/argus_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=argus_db
DATABASE_USER=argus
DATABASE_PASSWORD=argus_password

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider (future use)
AI_PROVIDER=mock
AI_API_KEY=

# Authentication (future use)
AUTH_SECRET=change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY=3600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ingestion
INGESTION_BATCH_SIZE=100
INGESTION_FLUSH_INTERVAL=5

# Data Retention (days)
RETENTION_LOGS=90
RETENTION_METRICS=90
RETENTION_TRACES=30
RETENTION_EVENTS=90
