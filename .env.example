# ARGUS Environment Configuration
# Copy this file to .env and update values

# Database
DATABASE_URL=postgresql+asyncpg://argus:argus_password@postgres:5432/argus_db
DATABASE_HOST=postgres
# Host port for Postgres. 5433 by default: 5432 is usually taken on a
# developer machine by another project's Postgres.
DATABASE_PORT=5433
DATABASE_NAME=argus_db
DATABASE_USER=argus
DATABASE_PASSWORD=argus_password

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
# Split the roles so sweep/detection work leaves the request path. Keep this true
# for the single-container topology; set it false on the HTTP service and run
# `docker compose --profile worker up -d` for sustained write load. Worker
# replicas coordinate through a per-sweep PostgreSQL advisory lock, so scaling the
# worker does not duplicate passes.
BACKGROUND_JOBS_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Reserved AI-provider fields: declared for a planned hosted-model path and
# **not read by any code path today**. The Phase 6 debugger runs on a
# deterministic context and its own provider abstraction, switched by
# DEBUG_AI_ENABLED; nothing in the request path calls out to a model vendor.
AI_PROVIDER=mock
AI_API_KEY=

# Legacy JWT fields (reserved; token authentication does not use them).
#
# The real auth model is bearer tokens with roles (ADMIN/OPERATOR/VIEWER),
# per-project grants, and per-source ingest tokens for the ingestion boundary —
# see docs/security-architecture.md. The bootstrap token is printed once to the
# API log on first boot:  docker compose logs api | grep -i "admin token"
AUTH_SECRET=change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY=3600
# Local-development escape hatch. Unset means auth is enforced everywhere except
# API_ENVIRONMENT=test; `true` is refused at boot when API_ENVIRONMENT=production.
AUTH_DISABLED=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ingestion
INGESTION_BATCH_SIZE=100
INGESTION_FLUSH_INTERVAL=5
# The asynchronous queue consumer. Set false only when the role is separated out
# (`--profile worker`) or when a deployment deliberately ingests synchronously.
INGESTION_WORKER_ENABLED=true

# Data Retention (days)
RETENTION_LOGS=90
RETENTION_METRICS=90
RETENTION_TRACES=30
RETENTION_EVENTS=90

# Data Retention (days) — Phase 3
RETENTION_ANOMALIES=180
RETENTION_INCIDENTS=365

# Anomaly & Incident Intelligence (Phase 3)
ANOMALY_DETECTION_ENABLED=true
ANOMALY_DETECTION_ASYNC=true
ANOMALY_SWEEP_ENABLED=true
ANOMALY_SWEEP_INTERVAL_SECONDS=60
ANOMALY_DEFAULT_WINDOW_SECONDS=300
ANOMALY_DEFAULT_COOLDOWN_SECONDS=300
ANOMALY_DEFAULT_MIN_SAMPLES=5
ANOMALY_Z_THRESHOLD=3.0
ANOMALY_MAX_TELEMETRY_SAMPLES=5000
CORRELATION_WINDOW_SECONDS=300
CORRELATION_MAX_ANOMALIES=200
CORRELATION_MAX_COMPONENT_HOPS=2

# Data Retention (days) — Phase 4
RETENTION_CAUSAL_ANALYSES=365

# Root Cause & Causal Analysis (Phase 4)
# Every bound is configuration: a hypothesis nobody can read is not a hypothesis.
CAUSAL_ANALYSIS_ENABLED=true
# How far back from incident onset evidence is collected.
CAUSAL_EVIDENCE_WINDOW_SECONDS=3600
# How long after onset a recovery still counts as recovery evidence.
CAUSAL_RECOVERY_WINDOW_SECONDS=1800
# Bounded candidate set (one hypothesis per component, not per discovery path).
CAUSAL_MAX_CANDIDATES=8
# Cap on stored evidence rows per analysis.
CAUSAL_MAX_EVIDENCE=200
# Cap on traces inspected per analysis.
CAUSAL_MAX_TRACES=100
# Structural neighbourhood depth in the Phase 2 knowledge graph.
CAUSAL_MAX_DEPENDENCY_HOPS=4
# How close a deployment/configuration change must be to onset to be relevant.
CAUSAL_CHANGE_PROXIMITY_SECONDS=900
# Score a candidate must reach before it may be named the primary hypothesis;
# below it ARGUS answers UNKNOWN at INSUFFICIENT confidence.
CAUSAL_PRIMARY_MIN_SCORE=0.5
# Maximum gap between chain links; a longer gap breaks the chain rather than
# bridging it.
CAUSAL_CHAIN_MAX_GAP_SECONDS=600

# Failure Reproduction (Phase 5)
# Phase 5 executes things, so every boundary is configuration and none of it is
# optional: a sandbox that runs with the wrong limits is worse than no sandbox.
REPRODUCTION_ENABLED=true
# `local` runs one process per sandbox service behind POSIX resource limits and
# is always available. `docker` runs one container per service on an internal
# network (capabilities dropped, read-only root fs) and refuses clearly if the
# daemon is unreachable rather than silently falling back.
REPRO_SANDBOX_BACKEND=local
# Leave empty to use the system temp directory. Never point this at the repo.
REPRO_SANDBOX_ROOT=
# Where an experiment's artifacts are stored; they must outlive the sandbox.
REPRO_ARTIFACT_ROOT=
REPRO_DOCKER_IMAGE=python:3.11-alpine
# Default deny. `MOCK_DEPENDENCIES`/`CONTROLLED_EGRESS` exist for allow-listed
# cases and are reported as a warning on the safety page.
REPRO_NETWORK_POLICY=ISOLATED
REPRO_EGRESS_ALLOWLIST=[]
# Per-experiment deadline and sandbox startup budget.
REPRO_EXPERIMENT_TIMEOUT_SECONDS=300
REPRO_PROVISION_TIMEOUT_SECONDS=60
# Per-sandbox limits.
REPRO_MAX_CPU_SECONDS=60
REPRO_MAX_MEMORY_MB=512
REPRO_MAX_DISK_MB=64
REPRO_MAX_PROCESSES=32
# Bounded replay and bounded capture.
REPRO_MAX_REPLAY_REQUESTS=200
REPRO_MAX_TELEMETRY_SIGNALS=5000
REPRO_MAX_TELEMETRY_BYTES=8000000
REPRO_MAX_INPUTS=50
# Replay dispatch; concurrency is opt-in.
REPRO_DEFAULT_REPLAY_MODE=SEQUENTIAL
# How many repetitions an experiment may be asked for.
REPRO_MAX_REPETITIONS=10
REPRO_DEFAULT_REPETITIONS=1
# Alignment window when comparing reproduced and original sequences.
REPRO_SEQUENCE_TOLERANCE_SECONDS=120
# Reproduction telemetry must never be written into production tables.
REPRO_FORWARD_TELEMETRY=false
# Reaper: closes abandoned experiments and destroys orphaned sandboxes.
REPRO_SWEEP_ENABLED=true
REPRO_SWEEP_INTERVAL_SECONDS=60
RETENTION_REPRODUCTIONS=180

# --- Phase 6: code intelligence & AI debugger --------------------------------
# Master switch for indexing and analysis. With it off, every code-level surface
# reports that code intelligence is disabled rather than pretending to be empty.
CODE_INTELLIGENCE_ENABLED=true
# Where repositories may be read from. **Empty means nothing is readable**, which
# is the default: the indexer refuses a path outside this list, so the allowlist
# is a security boundary, not a hint. The compose stack mounts repositories at
# /repos.
CODE_ALLOWED_ROOTS=[]
# Per-snapshot ceilings. A repository larger than the cap is indexed up to it and
# the snapshot records that it was truncated.
CODE_MAX_FILES_PER_SNAPSHOT=20000
# Indexing sweep: picks up repositories whose revision changed since the last
# snapshot and re-indexes incrementally, by content hash rather than timestamp.
CODE_SWEEP_ENABLED=true
CODE_SWEEP_INTERVAL_SECONDS=120
RETENTION_CODE_SNAPSHOTS=365

# --- Phase 7: fix generation & verification ----------------------------------
# Workspace hygiene and budgets for patch verification. The sweep destroys
# workspaces left behind by a process that died, and no patch is reported as
# verified without running the registered commands inside these budgets.
FIX_SWEEP_ENABLED=true
FIX_SWEEP_INTERVAL_SECONDS=120
FIX_WORKSPACE_GRACE_SECONDS=3600
FIX_COMMAND_TIMEOUT_SECONDS=900

# --- Phase 8: predictive reliability -----------------------------------------
# Master switch. The scheduled sweep generates due forecasts, scores elapsed
# horizons, refreshes warnings and expires what has passed.
RELIABILITY_FORECASTING_ENABLED=true
RELIABILITY_SWEEP_ENABLED=true
RELIABILITY_SWEEP_INTERVAL_SECONDS=300
# Below this many usable samples a series cannot carry a forecast at all; the
# result is UNKNOWN, never a low-risk reading.
RELIABILITY_MIN_SAMPLES=5
RELIABILITY_FEATURE_WINDOW_SECONDS=3600
RELIABILITY_BASELINE_WINDOW_SECONDS=86400
RELIABILITY_STALE_TELEMETRY_SECONDS=3600
# Centralized risk policy. Change these here, not in code.
RELIABILITY_THRESHOLD_MEDIUM=0.35
RELIABILITY_THRESHOLD_HIGH=0.60
RELIABILITY_THRESHOLD_CRITICAL=0.80
RELIABILITY_MIN_COVERAGE=0.66
# Early warnings: floor and rate limit. They are notifications, never actions.
RELIABILITY_WARNING_MIN_RISK_LEVEL=HIGH
RELIABILITY_WARNING_COOLDOWN_SECONDS=1800
# Optional narrative on the forecast explanation:
#   none          the API is fully deterministic (default)
#   deterministic compose prose from stored rows, no model
#   model         re-word with the configured AI provider; a mock provider is
#                 treated as none, since fabricated prose about a real system
#                 is worse than no prose
RELIABILITY_NARRATIVE_PROVIDER=none
# Retention: forecasts and derived rows, then evaluation/backtest/drift history.
RETENTION_RELIABILITY_FORECASTS=180
RETENTION_RELIABILITY_EVALUATIONS=365

# ---------------------------------------------------------------------------
# Phase 9 — safe autonomous remediation
# ---------------------------------------------------------------------------
# Master switch. false turns every live effect off in this process, whatever the
# database says: proposals, assessments and decisions are still recorded.
REMEDIATION_EXECUTION_ENABLED=true
# The regime used when a project has no policy row. A missing policy is a
# restrictive default (OBSERVE_ONLY), never a permissive one.
REMEDIATION_DEFAULT_MODE=OBSERVE_ONLY
# Environments whose *names* mark them as non-production. Autonomous execution is
# only ever considered here, and only for actions the registry says may run
# unattended under the risk ceiling — and only when the environment is also not
# declared PRODUCTION.
REMEDIATION_NON_PRODUCTION_ENVIRONMENT_NAMES=development,dev,test,testing,staging,sandbox,local,preview,demo
# Closed set of action types execution will attempt at all. Anything else is
# refused with ENVIRONMENT_NOT_ALLOWED before a handler is selected.
REMEDIATION_ENABLED_ACTION_TYPES=PAUSE_BACKGROUND_JOB,RESUME_BACKGROUND_JOB,DISABLE_FEATURE_FLAG,ENABLE_FEATURE_FLAG,DISABLE_DEGRADED_DEPENDENCY
# The known targets a plan may name. An unknown flag or job is a validation
# failure, not a no-op.
# REMEDIATION_KNOWN_FEATURE_FLAGS / REMEDIATION_KNOWN_BACKGROUND_JOBS have
# sensible defaults; override to extend them.

# Operator ceilings. A stored policy can never raise a limit above these: the
# effective value is the minimum of the two, and the clamp is reported.
REMEDIATION_HARD_MAX_RISK_AUTONOMOUS=LOW
REMEDIATION_HARD_MAX_ACTIONS_PER_WINDOW=20
REMEDIATION_HARD_MAX_CONCURRENT_ACTIONS=3
REMEDIATION_HARD_MAX_BLAST_RADIUS_PERCENT=50.0
REMEDIATION_HARD_MAX_BLAST_RADIUS_SCOPE=ENVIRONMENT
REMEDIATION_HARD_EXECUTION_TIMEOUT_SECONDS=600

# Loop protection: bounded effort per scope and per window.
REMEDIATION_ACTION_WINDOW_SECONDS=3600
REMEDIATION_DEFAULT_MAX_ACTIONS_PER_WINDOW=5
REMEDIATION_DEFAULT_COOLDOWN_SECONDS=60
REMEDIATION_DEFAULT_MAX_CONCURRENT_ACTIONS=1
REMEDIATION_CIRCUIT_FAILURE_THRESHOLD=3
REMEDIATION_CIRCUIT_RESET_SECONDS=900
REMEDIATION_CIRCUIT_HALF_OPEN_PROBES=1
REMEDIATION_MAX_EXECUTION_ATTEMPTS=2
REMEDIATION_EXECUTION_TIMEOUT_SECONDS=120
REMEDIATION_APPROVAL_TTL_SECONDS=1800
REMEDIATION_ACTION_EXPIRY_SECONDS=86400

# Canary execution for actions that declare support for it.
REMEDIATION_CANARY_ENABLED=true
REMEDIATION_CANARY_PERCENT=10.0

# Verification reads real telemetry over a window; success is a verdict, not the
# handler's return value.
REMEDIATION_VERIFICATION_WINDOW_SECONDS=300
REMEDIATION_VERIFICATION_GRACE_SECONDS=30
REMEDIATION_MAX_VERIFICATION_ATTEMPTS=2
REMEDIATION_VERIFICATION_MIN_SAMPLES=3
REMEDIATION_ERROR_RATE_TOLERANCE=0.2
REMEDIATION_LATENCY_TOLERANCE=0.25

# Proposal planning from incidents and forecasts.
REMEDIATION_PLANNER_ENABLED=true
REMEDIATION_MAX_PROPOSALS_PER_RUN=10
REMEDIATION_PROPOSAL_DEDUP_WINDOW_SECONDS=3600
REMEDIATION_MIN_PROPOSAL_CONFIDENCE=0.2

# The remediation sweep (expiry, retries, verification windows, stale attempts).
REMEDIATION_ASYNC=true
REMEDIATION_SWEEP_ENABLED=true
REMEDIATION_SWEEP_INTERVAL_SECONDS=60
REMEDIATION_SWEEP_BATCH=25
# Retention for the remediation ledger.
RETENTION_REMEDIATION_ACTIONS=730

# ---------------------------------------------------------------------------
# Phase 10 — reliability intelligence & autonomous learning
# ---------------------------------------------------------------------------
# Master switch for the learning pipeline. When off, outcomes are still recorded
# as events (they are evidence) but no run consumes them.
INTELLIGENCE_LEARNING_ENABLED=true
INTELLIGENCE_SWEEP_ENABLED=true
INTELLIGENCE_SWEEP_INTERVAL_SECONDS=300
# Bounded work per run: a pass must not be able to scan an unbounded history.
INTELLIGENCE_LEARNING_BATCH=500
INTELLIGENCE_MAX_PATTERNS_PER_RUN=200

# Observation floors before a pattern may leave CANDIDATE (and before it may be
# called high-confidence). These are policy defaults, not statistical results —
# change them here, and the knowledge rows record which thresholds were applied.
INTELLIGENCE_MIN_SAMPLES_CANDIDATE=3
INTELLIGENCE_MIN_SAMPLES_VALIDATION=5
INTELLIGENCE_MIN_SAMPLES_HIGH_CONFIDENCE=10
# A pattern is tested across two adjacent windows of this length; if it does not
# appear in both, it is unstable and is not promoted.
INTELLIGENCE_STABILITY_WINDOW_DAYS=30
# Below this support ratio the confidence bucket is LOW at best.
INTELLIGENCE_MIN_SUPPORT_STRENGTH=0.5

# Retrieval: similarity floor and result cap for "have we seen this before?".
INTELLIGENCE_SIMILARITY_THRESHOLD=0.45
INTELLIGENCE_SIMILARITY_MAX_RESULTS=25
# Effectiveness is only reported when this many comparable cases back it;
# below it the answer is "insufficient evidence".
INTELLIGENCE_MIN_EFFECTIVENESS_SAMPLES=3

# Knowledge that new data stops confirming for this long is marked STALE
# (deprecated, never deleted).
INTELLIGENCE_KNOWLEDGE_STALE_AFTER_DAYS=90

# Autonomous activation: off by default. Even when on, only informational
# patterns with HIGH confidence may activate themselves — remediation, recovery
# and predictive patterns always wait for a person.
INTELLIGENCE_AUTO_ACTIVATE_ENABLED=false

# Which provenance classes the pipeline learns from. AI_GENERATED and MOCK are
# excluded by default: an AI root-cause hypothesis is not a confirmed root
# cause, and a mock row is not history.
INTELLIGENCE_INCLUDE_AI_GENERATED=false
INTELLIGENCE_INCLUDE_MOCK=false

# The chronic-reliability signal. It recommends investigation; it never disables
# or modifies anything.
INTELLIGENCE_CHRONIC_WINDOW_DAYS=30
INTELLIGENCE_CHRONIC_INCIDENT_THRESHOLD=5
INTELLIGENCE_CHRONIC_REMEDIATION_THRESHOLD=4
# Windows recomputed by each run, in days.
INTELLIGENCE_PROFILE_WINDOWS=[7, 30, 90]

# How long an open recommendation stands before it expires.
INTELLIGENCE_RECOMMENDATION_TTL_SECONDS=86400

# Retention: learning events, then derived experiences and knowledge history.
RETENTION_LEARNING_EVENTS=180
RETENTION_RELIABILITY_EXPERIENCES=730

# ---------------------------------------------------------------------------
# Phase 11 — unified reliability platform & control plane
# ---------------------------------------------------------------------------
# Master switches for the platform and its sweep (the control-plane clock that
# correlates events, routes incidents into cases, advances workflows, recomputes
# SLOs and runs the consistency checks).
PLATFORM_ENABLED=true
PLATFORM_SWEEP_ENABLED=true
PLATFORM_SWEEP_INTERVAL_SECONDS=120

# §2–§5. How the system state is derived. These windows are policy, not truth:
# how long a component stays RECOVERING, how far back telemetry counts as fresh
# evidence, how far back an unresolved anomaly still affects state, and how far
# back "recent changes" reaches.
PLATFORM_STATE_RECOVERY_WINDOW_SECONDS=1800
PLATFORM_STATE_TELEMETRY_WINDOW_SECONDS=3600
PLATFORM_STATE_ANOMALY_WINDOW_SECONDS=86400
PLATFORM_STATE_CHANGE_WINDOW_DAYS=7
# Bounds so the dashboard cannot run unbounded queries (§65).
PLATFORM_STATE_COMPONENT_LIMIT=500
PLATFORM_STATE_DEPENDENCY_LIMIT=1000
PLATFORM_STATE_ACTIVE_LIMIT=100

# §14, §16. Auto-open cases from high-severity incidents, and how far *before* a
# case opened its evidence is collected — a case investigates something that has
# already happened, so the window must include the triggering anomaly.
PLATFORM_AUTO_CASE_ENABLED=true
PLATFORM_CASE_EVIDENCE_LOOKBACK_SECONDS=86400

# §61, §62. Capability flags that can cause external side effects default to
# disabled. Cross-project intelligence is off so PROJECT_LOCAL is the default.
PLATFORM_CASE_ASSISTANT_ENABLED=false
PLATFORM_AI_ASSISTANT_ENABLED=false
PLATFORM_CROSS_PROJECT_INTELLIGENCE_ENABLED=false
PLATFORM_POSTMORTEM_TIMELINE_LIMIT=100

# §63, §65. Rate limits (per minute; 0 disables) and the hard per-kind cap on
# search results.
PLATFORM_SEARCH_RATE_LIMIT_PER_MINUTE=120
PLATFORM_SEARCH_MAX_PER_KIND=25
PLATFORM_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
PLATFORM_AI_RATE_LIMIT_PER_MINUTE=30

# §34, §35. Error-budget burn thresholds as burn-rate multiples. Explicit
# because "fast burn" is a policy, not a fact.
PLATFORM_BURN_ELEVATED=2.0
PLATFORM_BURN_FAST=6.0
PLATFORM_BURN_CRITICAL=14.0
PLATFORM_SLO_AT_RISK_BURN=1.0
PLATFORM_SLO_MAX_WINDOW_SECONDS=2592000
PLATFORM_SLO_SNAPSHOT_LIMIT=200

# §56. Notification dedup: identical fingerprints inside this window collapse
# into one notification with a count.
PLATFORM_NOTIFICATION_COOLDOWN_SECONDS=900
PLATFORM_NOTIFICATION_BATCH_LIMIT=200
PLATFORM_NOTIFICATION_CHANNELS=["IN_APP"]

# §64. Redis-backed cache TTLs in seconds (0 disables a surface's cache).
PLATFORM_STATE_CACHE_TTL_SECONDS=30
PLATFORM_DASHBOARD_CACHE_TTL_SECONDS=30
PLATFORM_SEARCH_CACHE_TTL_SECONDS=20

# §49, §50. Webhook replay protection: accepted timestamp skew, and the shared
# secret. An empty secret means webhooks are refused rather than accepted
# unsigned.
PLATFORM_WEBHOOK_TOLERANCE_SECONDS=300
PLATFORM_WEBHOOK_SECRET=

# §58, §105. Thresholds at which ARGUS reports *itself* as degraded.
PLATFORM_DB_SLOW_QUERY_MS=1000
PLATFORM_DB_POOL_WARN_PERCENT=80.0
PLATFORM_QUEUE_DEPTH_WARN=1000
PLATFORM_INGESTION_FAILURE_WARN=50

# §13. Workflow safety: evidence max age, total deadline, and poll interval.
PLATFORM_WORKFLOW_DEADLINE_SECONDS=86400
PLATFORM_WORKFLOW_EVIDENCE_MAX_AGE_SECONDS=3600
PLATFORM_WORKFLOW_APPROVAL_POLL_SECONDS=60
PLATFORM_WORKFLOW_BATCH=50

# §41, §75, §76, §84. Comparison and trend lookbacks.
PLATFORM_COMPARISON_DEPLOYMENT_LIMIT=20
PLATFORM_COMPARISON_COMPONENT_LIMIT=200
PLATFORM_DEPLOYMENT_INCIDENT_WINDOW_HOURS=24
PLATFORM_DEPLOYMENT_SIMILARITY_LIMIT=10
PLATFORM_CHANGE_FAILURE_WINDOW_DAYS=30
PLATFORM_TREND_WINDOWS=[7, 30, 90]

# Retention for the platform's own derived rows. Generous by design: losing a
# state transition or a platform event erases history ARGUS cannot reconstruct.
RETENTION_PLATFORM_EVENTS_DAYS=365
RETENTION_PLATFORM_SNAPSHOTS_DAYS=180
RETENTION_PLATFORM_NOTIFICATIONS_DAYS=365

# =============================================================================
# Production hardening
# =============================================================================

# Demo dataset. Unset means: seeded in development/test, skipped in production.
# Set to `false` on any deployment you care about so a fresh database starts
# empty and only contains what you ingest or create.
SEED_DEMO=

# Authentication. Unset means: enforced everywhere except API_ENVIRONMENT=test.
# `true` bypasses auth for local development only and is REFUSED when
# API_ENVIRONMENT=production. On first boot ARGUS creates a root admin token and
# prints it once to the API log; manage further tokens via the CLI
# (`python -m app.cli`) or Settings -> Access Tokens in the web UI.
AUTH_DISABLED=

# Request bodies larger than this are refused with 413 before being read.
MAX_REQUEST_BODY_BYTES=10485760

# JSON bodies nested deeper than this are refused with 413 before any parser
# descends into them (a recursive parser on a hostile body raises and returns
# an unhandled 500). No legitimate ARGUS payload is anywhere near it.
MAX_JSON_DEPTH=64

# Edge rate limiting (token bucket, keyed by credential, falling back to client
# IP).
#
# RATE_LIMIT_BACKEND selects where the counter lives:
#   auto    (default) shared through Redis when reachable, per-process otherwise
#   redis   always shared; a global ceiling across every worker and host
#   memory  per process — the effective ceiling is API_WORKERS x the values below,
#           per host. Use only for a single-process deployment.
# The fallback is honest, not silent: argus_rate_limit_backend reports which mode
# a process is in and the alert rules fire when it degrades.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=120
RATE_LIMIT_REDIS_KEY_PREFIX=argus:rl:

# Identity of this process, for dashboards and multi-region deployments. INSTANCE_ID
# defaults to hostname:pid when empty; INSTANCE_REGION is a label only — it changes
# no routing or replication behaviour (see docs/high-availability.md).
INSTANCE_ID=
INSTANCE_REGION=local

# ---------------------------------------------------------------------------
# Single sign-on (OIDC)
# ---------------------------------------------------------------------------
# Off by default, and every value below is inert until OIDC_ENABLED is true.
# Enabling it with a missing issuer/client/secret is refused at boot (a
# half-configured provider is a security hole, not a degraded mode). In
# production the issuer must be https, because the JWKS is the trust anchor.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The URI registered with the provider; the app's callback page is /auth/callback.
OIDC_REDIRECT_URI=
OIDC_SCOPES=["openid", "email", "profile"]
# Claim -> role mapping. A token holding none of the values below gets
# OIDC_DEFAULT_ROLE (VIEWER). Roles are the same ADMIN/OPERATOR/VIEWER model as
# API tokens; optional OIDC_PROJECT_CLAIM maps a claim value to a project grant.
OIDC_ROLE_CLAIM=groups
OIDC_ADMIN_CLAIM_VALUES=[]
OIDC_OPERATOR_CLAIM_VALUES=[]
OIDC_DEFAULT_ROLE=VIEWER
OIDC_PROJECT_CLAIM=
# Restrict sign-in by email domain, and require a verified email by default.
OIDC_ALLOWED_EMAIL_DOMAINS=[]
OIDC_REQUIRE_VERIFIED_EMAIL=true
OIDC_SESSION_TTL_SECONDS=43200
OIDC_STATE_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_LEEWAY_SECONDS=60
OIDC_JWKS_CACHE_SECONDS=900
# One live session per identity (a new sign-in supersedes the old one).
OIDC_SINGLE_SESSION=true
# Where to send the browser after login; empty derives it from OIDC_REDIRECT_URI.
OIDC_POST_LOGIN_REDIRECT=
# Retention for the OIDC session/state table.
RETENTION_OIDC_SESSIONS_DAYS=30

# ---------------------------------------------------------------------------
# Scheduled backup (the `backup` compose profile)
# ---------------------------------------------------------------------------
# infrastructure/backup-scheduler.sh dumps on an interval, rehearses a restore on
# a longer interval, and prunes old dumps. Freshness is recorded in Postgres and
# alerted on (ArgusBackupStale / ArgusBackupNeverSucceeded / ArgusBackupDrillStale).
# Dumps land in BACKUP_DIR *inside the container* — ship them off-host too.
BACKUP_INTERVAL_HOURS=24
BACKUP_DRILL_INTERVAL_HOURS=168
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/backups

# ---------------------------------------------------------------------------
# Self-observability (the `observability` compose profile)
# ---------------------------------------------------------------------------
# Prometheus and Grafana with 20 alert rules and an overview dashboard live in
# infrastructure/observability/. They are an opt-in profile; nothing above needs
# them to run.
#   docker compose --profile observability up -d   # Prometheus :9090, Grafana :3001

# ---------------------------------------------------------------------------
# PostgreSQL high availability & point-in-time recovery (docker-compose.ha.yml)
# ---------------------------------------------------------------------------
# Applied as an overlay, not through .env:
#   docker compose -f docker-compose.yml -f docker-compose.ha.yml up -d
# It turns on WAL archiving and adds a streaming replica on host port 5434.
# There is no automatic failover. See docs/high-availability.md.
