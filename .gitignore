*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Database
*.db
*.sqlite3

# Logs (generated). Anchored to the repository root on purpose: an unanchored
# `logs/` also matched source directories such as
# `apps/web/app/observability/logs/`, which silently excluded a real route from
# the repository.
*.log
/logs/

# Coverage
htmlcov/
.coverage
coverage.xml

# Build artifacts
*.egg
*.whl

# Temporary
tmp/
temp/

# Generated runtime output — never source.
# The Phase 5 reproduction artifact store writes here (plan/manifest/telemetry/
# comparison/validation records per experiment) when the API runs from `apps/api`,
# and the sandbox reaper's reports land beside it. These are regenerated by the
# next experiment, so they must never be committed.
var/
**/var/
apps/api/var/

# Local agent/tooling metadata (never part of the project)
.freebuff/
.claude/

# Generated Postgres dumps from `infrastructure/backup.sh` (never source: they
# are hundreds of megabytes and contain production data). The gate writes its own
# dumps to a temporary directory; this entry covers manual runs.
backups/
*.dump
*.dump.counts
